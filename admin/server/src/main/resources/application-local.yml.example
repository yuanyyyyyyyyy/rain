# 本机敏感配置模板 — 复制为同目录 application-local.yml 并填入真实值
# application-local.yml 已 gitignore，凭据永不入库
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/rain_admin?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: rain
    password: "<本机MySQL密码>"

app:
  jwt:
    # 至少 32 字节随机串（例如 openssl rand -hex 32 生成）；泄露即轮换
    secret: "<至少32字节随机串>"
  storage:
    # 前台 public 目录绝对路径（照片上传后写入其 photos/ 子目录）
    frontend-public-dir: "G:/Improve/MI/rain/public"
